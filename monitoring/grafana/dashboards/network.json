    {
      "type": "table",
      "title": "Latest blocks",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "indexer"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "indexer"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT height,\n       block_time AS time,\n       'blk:' || encode(hash, 'hex') AS hash,\n       'addr:' || encode(miner, 'hex') AS miner,\n       leaf_count AS txs,\n       size_bytes AS bytes,\n       difficulty\nFROM blocks WHERE canonical ORDER BY height DESC LIMIT 20"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
