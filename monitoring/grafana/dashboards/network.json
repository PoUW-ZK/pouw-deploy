    {
      "type": "timeseries",
      "title": "Transactions and proofs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "indexer"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "indexer"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(block_time, $__interval),\n       sum(leaf_count) AS \"transactions incl. proofs\",\n       sum((SELECT count(*) FROM proof_txs p WHERE p.block_hash = b.hash)) AS proofs\nFROM blocks b WHERE canonical AND $__timeFilter(block_time) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
