    {
      "type": "timeseries",
      "title": "Block time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "indexer"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "indexer"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT block_time AS time,\n       EXTRACT(EPOCH FROM block_time - lag(block_time) OVER (ORDER BY height)) AS \"block time\"\nFROM blocks WHERE canonical AND $__timeFilter(block_time) ORDER BY height"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
