          "rawQuery": true,
          "rawSql": "SELECT 'addr:' || left(encode(miner, 'hex'), 8) AS miner, count(*) AS blocks FROM (SELECT * FROM blocks WHERE canonical ORDER BY height DESC LIMIT 100) b GROUP BY 1 ORDER BY 2 DESC"
