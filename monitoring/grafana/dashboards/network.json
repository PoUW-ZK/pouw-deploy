    {
      "type": "stat",
      "title": "Proofs / block",
      "description": "Proof transactions per block over the last 100 blocks.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "indexer"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "indexer"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT count(*) FROM proof_txs WHERE block_hash IN (SELECT hash FROM (SELECT * FROM blocks WHERE canonical ORDER BY height DESC LIMIT 100) b))::float / NULLIF((SELECT count(*) FROM (SELECT * FROM blocks WHERE canonical ORDER BY height DESC LIMIT 100) b), 0) AS \"proofs per block\""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
