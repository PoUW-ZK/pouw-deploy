    {
      "type": "stat",
      "title": "Transactions / s",
      "description": "Transactions including proof transactions (header tx_count) per second over the last 100 blocks.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "indexer"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "indexer"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(leaf_count) / NULLIF(EXTRACT(EPOCH FROM max(block_time) - min(block_time)), 0) AS \"tx/s\" FROM (SELECT * FROM blocks WHERE canonical ORDER BY height DESC LIMIT 100) b"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
