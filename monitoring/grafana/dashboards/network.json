    {
      "type": "stat",
      "title": "Block time",
      "description": "Average time between the last 100 canonical blocks.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "indexer"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "indexer"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT EXTRACT(EPOCH FROM max(block_time) - min(block_time)) / NULLIF(count(*) - 1, 0) AS \"block time\" FROM (SELECT * FROM blocks WHERE canonical ORDER BY height DESC LIMIT 100) b"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 4,
