# Secrets that services receive as /run/secrets/<file>
# Values live in pass on the server, locally in .secrets/ (generated)
#
# kind:
#   random   random password, scripts/pass-init.sh creates it in pass
#   manual   must be inserted by hand: pass insert -m <path>
#   ssh-key  internal key, not in pass, created when the server starts
#
# file                        path in pass                     kind
grafana_admin_password        pouw/grafana/admin               random
jenkins_admin_password        pouw/jenkins/admin               random
github_webhook_secret         pouw/github/webhook-secret       random
github_oauth_client_id        pouw/github/oauth-client-id      manual
github_oauth_client_secret    pouw/github/oauth-client-secret  manual
github_app_id                 pouw/github/app-id               manual
github_app_key                pouw/github/app-key              manual
smtp_username                 pouw/smtp/username               manual
smtp_password                 pouw/smtp/password               manual
jenkins_agent_ssh_key         -                                ssh-key
