# --- Locally (Prometheus, Grafana) ---
COMPOSE_PROFILES=
# COMPOSE_PROFILES=jenkins       # also Jenkins at http://localhost:8080 (admin / .secrets/jenkins_admin_password)
# JENKINS_LOCAL_BRANCH=main      # pouw-deploy branch tested by the local Jenkins

# --- Server: uncomment and fill in ---
# COMPOSE_PROFILES=jenkins,proxy
# SECRETS_SOURCE=pass
# SECRETS_DIR=/run/pouw-secrets
#
# The domain must point to the server's public IP (A record). Without your own
# domain, e.g. jenkins.<ip-with-dashes>.sslip.io works
# JENKINS_HOST=jenkins.example.org
# GRAFANA_HOST=grafana.example.org
# JENKINS_URL=https://jenkins.example.org/
# GRAFANA_URL=https://grafana.example.org/
# ACME_EMAIL=name@stuba.sk
#
# Jenkins login via GitHub (local = admin and password from secrets)
# JENKINS_AUTH=github
# GitHub accounts with full rights in Jenkins, comma-separated
# JENKINS_ADMINS=Faustynn
#
# E-mails from Jenkins (failed nightly build). SMTP username and password are in pass:
# pass insert -m pouw/smtp/username, pass insert -m pouw/smtp/password
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_FROM=jenkins@example.org
